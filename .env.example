NODE_ENV=development
HOST=0.0.0.0
PORT=3000
SESSION_SECRET=CHANGE_ME
DATABASE_PATH=./data/ommisissi.db
UPLOAD_PATH=./uploads
TIMEZONE=Africa/Tunis
MAX_UPLOAD_SIZE_MB=1000
# Trusted reverse proxy IPs/CIDRs, comma-separated; false disables trust.
TRUST_PROXY=false
# Enable only when accessing the app through HTTPS.
COOKIE_SECURE=false
# Public LAN setup. Disable once all TVs are enrolled.
ALLOW_DISPLAY_REGISTRATION=true
OFFLINE_TIMEOUT_SECONDS=90
